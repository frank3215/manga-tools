{
  "render": {
    "renderer": "default",
    "alignment": "auto",
    "font_size_offset": 0,
    "direction": "auto"
  },
  "upscale": {
    "upscaler": "esrgan",
    "upscale_ratio": null
  },
  "translator": {
    "translator": "nllb",
    "target_lang": "CHS",
    "no_text_lang_skip": false
  },
  "detector": {
    "detector": "default",
    "detection_size": 1024,
    "text_threshold": 0.5,
    "box_threshold": 0.7,
    "unclip_ratio": 2.3
  },
  "inpainter": {
    "inpainter": "lama_large",
    "inpainting_size": 1024,
    "inpainting_precision": "fp32"
  },
  "ocr": {
    "ocr": "48px",
    "min_text_length": 0,
    "ignore_bubble": 0
  },
  "kernel_size": 3,
  "mask_dilation_offset": 20
}