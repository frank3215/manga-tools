{
  "render": {
    "renderer": "default",
    "alignment": "auto",
    "font_size_offset": 0,
    "direction": "auto"
  },
  "upscale": {
    "upscaler": "esrgan",
    "upscale_ratio": null
  },
  "translator": {
    "translator": "sakura",
    "target_lang": "CHS",
    "no_text_lang_skip": false
  },
  "detector": {
    "detector": "default",
    "detection_size": 2048,
    "text_threshold": 0.5,
    "box_threshold": 0.6,
    "unclip_ratio": 2.3
  },
  "inpainter": {
    "inpainter": "lama_large",
    "inpainting_size": 1536,
    "inpainting_precision": "fp32"
  },
  "ocr": {
    "use_mocr_merge": false,
    "ocr": "mocr",
    "min_text_length": 0,
    "ignore_bubble": 0
  },
  "kernel_size": 3,
  "mask_dilation_offset": 20
}